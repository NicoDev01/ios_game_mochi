require "securerandom"

default_platform(:ios)

platform :ios do
  desc "Build, sign and upload MochaMocha to TestFlight"
  lane :testflight_release do
    xcodeproj = "App/App.xcodeproj"
    bundle_id = ENV["APP_BUNDLE_ID"].to_s.strip
    if bundle_id.empty?
      pbx_path = File.expand_path("../#{xcodeproj}/project.pbxproj", __dir__)
      pbx = File.exist?(pbx_path) ? File.read(pbx_path) : ""
      match = pbx.match(/PRODUCT_BUNDLE_IDENTIFIER\s*=\s*([^;]+);/)
      bundle_id = match ? match[1].strip.delete('"') : "com.mochamocha.app"
    end

    keychain_name = "ci_signing.keychain"
    keychain_password = SecureRandom.hex(16)

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    begin
      import_certificate(
        certificate_path: ENV.fetch("DIST_CERT_P12_PATH"),
        certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      team_id = ENV["APPLE_TEAM_ID"].to_s.strip
      if team_id.empty?
        subject = sh("security find-certificate -a -p #{keychain_name} | openssl x509 -noout -subject", log: false)
        ou_match = subject.match(/OU\s*=\s*([A-Z0-9]{10})/)
        UI.user_error!("Konnte Apple Team ID nicht aus dem Distribution-Zertifikat lesen. Bitte APPLE_TEAM_ID setzen.") unless ou_match
        team_id = ou_match[1]
      end

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
        is_key_content_base64: true
      )

      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        team_id: team_id,
        force: true,
        readonly: false
      )
      profile_name = lane_context[SharedValues::SIGH_NAME]

      update_code_signing_settings(
        path: xcodeproj,
        use_automatic_signing: false,
        team_id: team_id,
        bundle_identifier: bundle_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        targets: ["App"]
      )

      build_number = ENV["BUILD_NUMBER"].to_s.strip
      if build_number.empty?
        begin
          latest = latest_testflight_build_number(
            api_key: api_key,
            app_identifier: bundle_id,
            initial_build_number: 0
          )
          build_number = (latest + 1).to_s
        rescue StandardError
          build_number = (ENV["GITHUB_RUN_NUMBER"] || "1").to_s
        end
      end

      increment_build_number(
        xcodeproj: xcodeproj,
        build_number: build_number
      )

      build_app(
        project: xcodeproj,
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        output_name: "MochaMocha.ipa",
        export_options: {
          signingStyle: "manual",
          teamID: team_id,
          provisioningProfiles: {
            bundle_id => profile_name
          }
        }
      )

      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    ensure
      delete_keychain(name: keychain_name) if File.exist?(File.expand_path("~/Library/Keychains/#{keychain_name}-db"))
    end
  end
end
